{
  "id": "smoke-trail",
  "title": "Дымный след",
  "description": "Мягкие клубы дыма позади двигателя или ракеты.",
  "duration": 1.2,
  "loop": true,
  "params": {
    "color": { "type": "color", "label": "Цвет", "default": "#8b93a3" },
    "rate": { "type": "number", "label": "Частота, клубов/с", "default": 30, "min": 1, "max": 120, "step": 1 },
    "life": { "type": "number", "label": "Жизнь, с", "default": 1.1, "min": 0.1, "max": 10, "step": 0.1 },
    "size": { "type": "number", "label": "Размер, м", "default": 1.2, "min": 0.05, "max": 20, "step": 0.05 },
    "opacity": { "type": "number", "label": "Плотность", "default": 0.24, "min": 0, "max": 1, "step": 0.01 },
    "speed": { "type": "number", "label": "Разлёт, м/с", "default": 1.5, "min": 0, "max": 20, "step": 0.1 },
    "spread": { "type": "number", "label": "Разброс, м", "default": 0.35, "min": 0, "max": 5, "step": 0.05 }
  },
  "layers": [
    {
      "type": "smoke",
      "params": {
        "color": "#8b93a3",
        "rate": 30,
        "life": 1.1,
        "size": 1.2,
        "opacity": 0.24,
        "speed": 1.5,
        "spread": 0.35
      }
    }
  ]
}
